{
  "name": "@getclickfix/react-native",
  "version": "0.1.0",
  "description": "ClickFix customer support for React Native: provider and hooks (visitor, conversations, messages, files, typing, read receipts, realtime, help search, rating) over @getclickfix/visitor-core, plus optional themeable screens. Bare React Native and Expo.",
  "keywords": [
    "clickfix",
    "customer-support",
    "react-native",
    "expo",
    "chat",
    "mobile"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClickSolveMainTR/clickfix-sdks.git",
    "directory": "react-native"
  },
  "homepage": "https://getclickfix.com/docs/integration-guide",
  "bugs": {
    "url": "https://github.com/ClickSolveMainTR/clickfix-sdks/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    }
  },
  "dependencies": {
    "@getclickfix/visitor-core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-native": ">=0.81",
    "react-native-keychain": ">=9"
  },
  "peerDependenciesMeta": {
    "react-native-keychain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.28.6",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "29.7.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "test-renderer": "1.0.0"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "jest",
    "prepack": "node ../scripts/prepack.mjs react-native"
  }
}
