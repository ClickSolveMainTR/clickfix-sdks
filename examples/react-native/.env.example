# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app,
# so only public identifiers belong here; the identity secret stays with
# server.mjs (CLICKFIX_IDENTITY_SECRET in its own shell).
EXPO_PUBLIC_CLICKFIX_BASE_URL=https://support.example.com
EXPO_PUBLIC_CLICKFIX_WIDGET_ID=00000000-0000-0000-0000-000000000000
EXPO_PUBLIC_CLICKFIX_APP_KEY=cf_app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your machine's LAN address when testing on a phone (server.mjs, port 8787)
EXPO_PUBLIC_SUPPORT_SERVER_URL=http://192.168.1.10:8787
# Only in Expo Go: the package name registered with a development app key
# EXPO_PUBLIC_CLICKFIX_PACKAGE_NAME=com.example.clickfix.dev
