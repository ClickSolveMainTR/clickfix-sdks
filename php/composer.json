{
    "name": "clickfix/sdk",
    "description": "ClickFix public API client for PHP 8.1+: PSR-18 transport, typed errors, bounded retries, pagination, webhook signature verification and widget identity hashes.",
    "type": "library",
    "license": "MIT",
    "keywords": ["clickfix", "customer-support", "api-client", "webhooks", "psr-18"],
    "homepage": "https://github.com/ClickSolveMainTR/clickfix-php",
    "support": {
        "issues": "https://github.com/ClickSolveMainTR/clickfix-app-go/issues",
        "source": "https://github.com/ClickSolveMainTR/clickfix-php",
        "docs": "https://getclickfix.com/docs/integration-guide"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.20"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 client with request timeouts; any PSR-18 client works"
    },
    "autoload": {
        "psr-4": {
            "ClickFix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ClickFix\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": ["@composer validate --strict", "@cs", "@stan", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    }
}
